# Copy this file to .env and fill in your own values.

# Extra password gate on top of Cloudflare Access (defense in depth).
# Leave blank to disable (not recommended if the tunnel is ever misconfigured).
APP_PASSWORD=change-me

# Random long string used to sign the app's login cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# How many accounts to unfollow per day / delay between each, by default.
# Can also be tuned from the Review screen in the UI.
DEFAULT_DAILY_CAP=150
DEFAULT_MIN_DELAY_SEC=45
DEFAULT_MAX_DELAY_SEC=180

# Delay range (seconds) instagrapi waits between its own internal Instagram
# API calls (login, fetching the following list, etc). Keep conservative.
IG_DELAY_MIN=2
IG_DELAY_MAX=5

# IANA timezone the daily unfollow cap resets against. Containers default to
# UTC regardless of the host's own clock, so leaving this unset means "today"
# rolls over at UTC midnight -- hours off from your actual midnight.
APP_TIMEZONE=Asia/Jerusalem
